# Nexus AI Backend Environment Configuration

# Supabase Configuration (must match your Next.js frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# LangSmith Configuration (Optional - for AI tracing)
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=nexus-ai-backend

# Development Settings
DEBUG=true
LOG_LEVEL=info

# API Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_REQUEST_SIZE=10MB

# AI Service Configuration  
DEFAULT_AI_MODEL=gemini-2.0-flash-exp
AI_REQUEST_TIMEOUT=30
MAX_CONTENT_LENGTH=10000

# Performance Settings
DIFF_TIMEOUT=2.0
DIFF_EDIT_COST=4 